,"sport":"neutral","prompt":"Solve x² = 144 for all real x.","visual":null,"choices":["x = 12 or x = −12","x = 12","x = 72","x = 144 or x = −144"],"answer":{"kind":"choice","value":"x = 12 or x = −12"},"misconceptionMap":{"x = 12":"forgets-negative-root"},"hints":["Take the square root of both sides and attach ±.","(−12)² = 144 too."],"difficulty":2},{"id":"ALG-Q08-p1-neutral-03","version":1,"skillId":"ALG-Q08","phase":1,"sport":"neutral","prompt":"Solve (x − 3)² = 25 for all real x.","visual":null,"choices":["x = 8 or x = −2","x = 8","x = 28","x = 3 + 25"],"answer":{"kind":"choice","value":"x = 8 or x = −2"},"misconceptionMap":{"x = 8":"forgets-negative-root","x = 28":"roots-a-sum"},"hints":["Root the whole (x − 3): x − 3 = ±5.","Solve x − 3 = 5 and x − 3 = −5 separately."],"difficulty":2},{"id":"ALG-Q08-p1-neutral-04","version":1,"skillId":"ALG-Q08","phase":1,"sport":"neutral","prompt":"Solve (x − 6)² = 49 for all real x.","visual":null,"choices":["x = 13 or x = −1","x = 13","x = 55","x = 6 + 49"],"answer":{"kind":"choice","value":"x = 13 or x = −1"},"misconceptionMap":{"x = 13":"forgets-negative-root","x = 55":"roots-a-sum"},"hints":["Keep (x − 6) together: x − 6 = ±7.","Add 7, not 49, in each case."],"difficulty":3}],"p2":[{"id":"ALG-Q08-p2-baseball-01","version":1,"skillId":"ALG-Q08","phase":2,"sport":"baseball","prompt":"A model sets x² = 100, where x is a centered rating. Solving by extracting roots, which solution set is correct?","visual":null,"choices":["x = 10 or x = −10","x = 10","x = 50","x = 100 or x = −100"],"answer":{"kind":"choice","value":"x = 10 or x = −10"},"misconceptionMap":{"x = 10":"forgets-negative-root"},"hints":["x = ±√100. The ± keeps both roots.","(−10)² = 100."],"difficulty":1},{"id":"ALG-Q08-p2-baseball-02","version":1,"skillId":"ALG-Q08","phase":2,"sport":"baseball","prompt":"A centered stat satisfies (x − 3)² = 49. Extract roots to find every x.","visual":null,"choices":["x = 10 or x = −4","x = 10","x = 52","x = 3 + 49"],"answer":{"k